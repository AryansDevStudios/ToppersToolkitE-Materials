                },
                {
                  "id": 59,
                  "label": "Characteristics: Ample storage capacity, cost-effective, slower speed, mechanical components"
                }
              ]
            },
            {
              "id": 60,
              "label": "Solid State Drive (SSD)",
              "children": [
                {
                  "id": 61,
                  "label": "Utilises flash memory (no spinning disk)"
                },
                {
                  "id": 62,
                  "label": "Characteristics: Faster performance, compact form, lower power consumption, higher price point, no mechanical components"
                }
              ]
            },
            {
              "id": 63,
              "label": "Flash Drive (Pen drive, portable storage, USB port)",
              "children": [
                {
                  "id": 64,
                  "label": "Characteristics: Portability, Plug-and-Play, High Compatibility, Reusability"
                }
              ]
            }
          ]
        }
      ]
    },
