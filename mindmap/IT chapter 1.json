            { "id": 40, "label": "Non-verbal elements mismatch (mixed messages)", "children": [] },
            { "id": 41, "label": "Limited to auditory sensory channel (not accessible for hearing impaired)", "children": [] }
          ]
        }
      ]
    },
    {
