                  "children": [
                    { "id": 28, "label": "Letters (formal or informal postal messages)", "children": [] },
                    { "id": 29, "label": "SMS (Short Message Service, quick and brief updates)", "children": [] },
                    { "id": 30, "label": "Emails (electronic mail via computer network)", "children": [] },
                    { "id": 31, "label": "Books, newspapers, and magazines (for large audience)", "children": [] }
